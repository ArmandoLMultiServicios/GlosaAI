# Copia este archivo a .env y llena los valores.

# ─── Proveedor de IA ───
# Opcional: sobreescribe lo que dice config/settings.py.
# IA_PROVEEDOR=anthropic        # anthropic | gemini | openai
# IA_MODELO=claude-opus-5-5     # vacío = el de IA_MODELOS en settings.py
# IA_ESFUERZO=high              # low | medium | high | xhigh | max

# Llaves: solo hace falta la del proveedor que uses.
ANTHROPIC_API_KEY=sk-ant-...
# Solo si tu llave de Anthropic no está ligada a un workspace (ID tipo wrkspc_...)
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-...

# ─── Correo (envío del reporte) ───
# Microsoft 365:  CORREO_SMTP_HOST=smtp.office365.com   CORREO_SMTP_PUERTO=587  CORREO_SMTP_SEGURIDAD=tls
# Google:         CORREO_SMTP_HOST=smtp.gmail.com       CORREO_SMTP_PUERTO=587  CORREO_SMTP_SEGURIDAD=tls
# Para pruebas sin enviar nada: CORREO_SMTP_HOST=consola (el correo se imprime en la ventana).
CORREO_SMTP_HOST=
CORREO_SMTP_PUERTO=587
CORREO_SMTP_SEGURIDAD=tls          # tls | ssl | ninguna
CORREO_SMTP_USUARIO=glosa@multiservicios.mx
CORREO_SMTP_CONTRASENA=
# Remitente que verán los usuarios (normalmente la misma cuenta del usuario SMTP).
CORREO_REMITENTE=GlosaAI <glosa@multiservicios.mx>
# Dominio al que se envían los reportes: <usuario>@CORREO_DOMINIO
CORREO_DOMINIO=multiservicios.mx

# ─── Django ───
# 1 solo mientras desarrollas (muestra errores detallados); para usarlo, 0.
DJANGO_DEBUG=0
# Genera una con: .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Nombres o IP con los que se abrirá la página, separados por coma.
# Agrega la IP de esta PC si otras computadoras de la red la van a usar (p. ej. 192.168.1.50).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Solo si algún día se sirve por HTTPS con dominio propio:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://glosa.multiservicios.mx
# DJANGO_HTTPS=1
